<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FractureBench</AssemblyName>
    <RootNamespace>FractureBench</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- The bench is a HOST, not simulation: it owns the wall clock the sim is forbidden to
         touch. The banned-API analyzer is scoped to AsteroidsSim (PrivateAssets=all), so
         Stopwatch here is correct rather than a loophole. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../AsteroidsSim/AsteroidsSim.csproj" />
    <ProjectReference Include="../../AsteroidsSim.Config/AsteroidsSim.Config.csproj" />
  </ItemGroup>

</Project>
