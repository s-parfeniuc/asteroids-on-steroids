root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# Banned API analyzer findings are errors in the sim, not warnings.
dotnet_diagnostic.RS0030.severity = error

# Determinism-adjacent: flag anything that could reorder or vary.
dotnet_diagnostic.CA1307.severity = error   # StringComparison must be specified
dotnet_diagnostic.CA1310.severity = error   # StringComparison for correctness

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
