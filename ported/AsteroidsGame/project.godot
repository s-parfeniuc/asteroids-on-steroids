; Godot project configuration.
; Regenerated by the editor on save — keep hand edits minimal and documented.

config_version=5

[application]

config/name="Asteroids on Steroids"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="AsteroidsGame"

[physics]

; 60 Hz fixed tick. PORT_PLAN.md §2.7: halves every sim cost versus the old
; 120 Hz, and under lockstep the tick rate is a PROTOCOL parameter — it must be
; settled before a wire format exists.
common/physics_ticks_per_second=60

; Godot's own physics is not used for the simulation (PORT_PLAN.md §2.3).
; Spike B evaluated Rapier2D and rejected it (PHASE0.md); the simulation owns its
; own solver, so Godot's 2D physics is unused. Left at DEFAULT so the project runs
; without the addon installed.
2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

renderer/rendering_method="forward_plus"
2d/snap/snap_2d_transforms_to_pixel=false
